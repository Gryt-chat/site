.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cache/

# Emitted by scripts/emit-changelog-json.mjs on every build.
public/changelog.json

# Upload fodder for GitHub social previews, regenerated by yarn generate:banners.
public/repo-banners/
